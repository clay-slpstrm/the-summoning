# ══════════════════════════════════════════════
# The Summoning — Environment Configuration
# ══════════════════════════════════════════════
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── Chain ──
CHAIN_ID=11155111                              # 1 = mainnet, 11155111 = sepolia

# ── RPC ──
ALCHEMY_API_KEY=
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
WS_RPC_URL=wss://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# ── Contract Addresses (populated after deployment) ──
RITUAL_TOKEN_ADDRESS=
BONDING_CURVE_ADDRESS=
SUMMONING_ENGINE_ADDRESS=
ELDER_ARTIFACTS_ADDRESS=

# ── Backend ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/summoning
PORT=3001
WS_PORT=3002

# ── Frontend (NEXT_PUBLIC_ prefix for client-side) ──
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_WS_URL=ws://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_RITUAL_TOKEN_ADDRESS=
NEXT_PUBLIC_BONDING_CURVE_ADDRESS=
NEXT_PUBLIC_SUMMONING_ENGINE_ADDRESS=
NEXT_PUBLIC_ELDER_ARTIFACTS_ADDRESS=

# ── Deployment (contracts) ──
DEPLOYER_PRIVATE_KEY=                          # NEVER use on mainnet. Use --ledger instead.
ETHERSCAN_API_KEY=

# ── Chainlink (mainnet values — update for sepolia) ──
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
AUTOMATION_REGISTRY=
