# Mainnet deployment env — copy to .env.mainnet and fill in the blanks.
# .env.mainnet is gitignored. NEVER commit the filled-in file.
#
# Usage:
#   source .env.mainnet
#   forge script script/DeployMainnet.s.sol --rpc-url "$MAINNET_RPC_URL" --broadcast --verify

# ── Deployer / ownership ────────────────────────────────────────────────────
# Deployer EOA: pays gas only, holds no ownership after deploy. Fund ~0.15 ETH.
DEPLOYER_PRIVATE_KEY=
# Safe multisig (2-of-3) — becomes owner of all 5 contracts + royalty receiver.
MULTISIG_ADDRESS=

# ── RPC (Alchemy mainnet app) ───────────────────────────────────────────────
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
# Etherscan API key for --verify
ETHERSCAN_API_KEY=

# ── Chainlink VRF V2.5 — Ethereum mainnet ───────────────────────────────────
# Coordinator + key hashes verified against docs.chain.link/vrf/v2-5/supported-networks
# (2026-06-10). Coordinator is the same for all gas lanes.
VRF_COORDINATOR=0xD7f86b4b8Cae7D942340FF628F82735b7a20893a
# Gas lane: 200 gwei (cheapest). Callbacks only need to land while gas < 200 gwei,
# which matches current mainnet conditions (~0.03 gwei typical). Alternatives:
#   500 gwei:  0x3fd2fec10d06ee8f65e7f2e95f5c56511359ece3f33960ad8a866ae24a8ff10b
#   1000 gwei: 0xc6bf2e7b88e5cfbb4946ff23af846494ae1f3c65270b79ee7876c9aa99d3d45f
VRF_KEY_HASH=0x8077df514608a09f83e4e8d300645594e5d7234665448ba83f51a50f842bd3d9
# From vrf.chain.link after creating the mainnet subscription (uint256, long number).
VRF_SUBSCRIPTION_ID=
# Chainlink V2.5 callback ceiling. Worst-case 20-glyph batch measured 2.04M on Sepolia.
VRF_CALLBACK_GAS_LIMIT=2500000

# ── Metadata ────────────────────────────────────────────────────────────────
# Matches the live backend route (note the /api prefix). Script default is the same;
# set explicitly here so the deploy doesn't depend on the in-script fallback.
METADATA_BASE_URI=https://api.thesummoning.xyz/api/metadata/glyph/
